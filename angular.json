{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "runstat": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              }
            ],
            "styles": [
              "node_modules/@fontsource-variable/inter/wght.css",
              "node_modules/@fontsource/barlow-condensed/latin-600.css",
              "node_modules/@fontsource/barlow-condensed/latin-700.css",
              "node_modules/@fontsource/barlow-condensed/latin-800.css",
              "node_modules/leaflet/dist/leaflet.css",
              "src/styles.scss"
            ],
            "allowedCommonJsDependencies": [
              "leaflet",
              "buffer",
              "fit-file-parser"
            ],
            "loader": {
              ".fit": "binary",
              ".gz": "binary",
              ".zip": "binary",
              ".txt": "text",
              ".jsonl": "text",
              ".csv": "text",
              ".tcx": "text"
            },
            "webWorkerTsConfig": "tsconfig.worker.json",
            "define": {
              "RUNSTAT_LOCAL": "false"
            }
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            },
            "pages": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "1MB",
                  "maximumError": "2MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "8kB",
                  "maximumError": "16kB"
                }
              ],
              "outputHashing": "all",
              "serviceWorker": "ngsw-config.json",
              "baseHref": "/runstat/",
              "outputPath": "dist/runstat-pages",
              "define": {
                "RUNSTAT_LOCAL": "true"
              },
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "data/**"
                  ]
                }
              ],
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": true
              }
            },
            "local": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true,
              "define": {
                "RUNSTAT_LOCAL": "true"
              },
              "assets": [
                {
                  "glob": "**/*",
                  "input": "public",
                  "ignore": [
                    "data/**"
                  ]
                }
              ]
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "runstat:build:production"
            },
            "development": {
              "buildTarget": "runstat:build:development"
            },
            "local": {
              "buildTarget": "runstat:build:local"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        }
      }
    }
  }
}
