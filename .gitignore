/.angular/cache
.sass-cache/
/connect.lock
/coverage
/libpeerconnection.log
testem.log
/typings
__screenshots__/

# System files
.DS_Store
Thumbs.db

# Données personnelles Coros (ne pas publier)
/data-raw
/public/data

# Synchro automatique : secrets OAuth et réponses brutes des spikes
/secrets
/spike-output

# Comptes de l'instance (multi-utilisateur, sur le NAS)
/users
